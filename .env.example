# Copy this file to .env in this directory or at the repository root.
OPENAI_API_KEY=your_api_key_here
# Gemini OpenAI-compatible endpoint. Do not commit the real .env file.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Check the model ID available to your Gemini API key before running.
OPENAI_MODEL=gemini-2.5-flash
